{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev-task/review.schema.json",
  "title": "DEV_TASK_REVIEW",
  "description": "One review lens's findings (Phase 2.5). Output is exactly this block, so it can be schema-forced.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lens", "findings"],
  "properties": {
    "lens": { "type": "string", "enum": ["correctness", "security", "performance", "regression"] },
    "findings": {
      "type": "array",
      "description": "Empty array = nothing found (a clean pass).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "issue"],
        "properties": {
          "severity": { "type": "string", "enum": ["block", "warn", "nit"] },
          "file": { "type": "string", "description": "<path>:<line>" },
          "issue": { "type": "string", "description": "What is wrong, concretely." },
          "suggestion": { "type": "string", "description": "The fix." }
        }
      }
    }
  }
}
